# CyberShield Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=cybershield-super-secret-jwt-key-change-in-prod-2026
JWT_SECRET_KEY=cybershield-jwt-token-signing-secret-key-32bytes

# Database Configuration (mysql | mongo)
DB_BACKEND=mysql

# MySQL Connection Details
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=cybershield

# MongoDB Connection Details
MONGO_URI=mongodb://localhost:27017/cybershield
MONGO_DATABASE=cybershield

# Fallback Mode for local zero-dependency development (when local MySQL/Mongo daemon is offline)
ENABLE_DEV_FALLBACK=true

# API Server Port
PORT=5000
