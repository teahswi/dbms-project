# ==============================================================================
# CyberShield Environment Configuration Template
# Copy this file to .env and configure with your local or production credentials.
# DO NOT commit .env to version control.
# ==============================================================================

FLASK_ENV=development
FLASK_DEBUG=0

# Secret keys for session management and JWT authentication
# In production, generate strong random strings: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-secure-jwt-signing-secret-key-32-bytes

# Database Configuration
# Options:
#   - mysql   : Connect to MySQL 8.0+ server (recommended for relational evaluation)
#   - mongo   : Connect to MongoDB 6.0+/7.0+ instance
#   - sqlite  : Standalone local SQLite database (zero-dependency demo mode)
DB_BACKEND=sqlite

# MySQL Connection Details (Required when DB_BACKEND=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cybershield_user
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_DATABASE=cybershield

# MongoDB Connection Details (Required when DB_BACKEND=mongo)
MONGO_URI=mongodb://localhost:27017/cybershield
MONGO_DATABASE=cybershield

# Development Fallback Behavior:
# When set to 'false' (recommended for DBMS evaluation & production), a failed database connection
# will raise an explicit connection error rather than silently masking issues.
# When set to 'true', temporary dev fallback to SQLite/memory is allowed for offline UI previews.
ENABLE_DEV_FALLBACK=false

# API Server Port
PORT=5000
