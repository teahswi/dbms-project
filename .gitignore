# ==============================================================================
# CyberShield - Git Ignore Configuration
# ==============================================================================

# Environment variables & secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Python virtual environments & bytecode
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases and local mutable state
*.db
*.sqlite
*.sqlite3
cybershield_local.db

# IDE and Editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Frontend dependencies and production builds
frontend/node_modules/
frontend/dist/
frontend/build/
node_modules/
dist/
build/
.npm
*.tsbuildinfo

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
temp/
tmp/
